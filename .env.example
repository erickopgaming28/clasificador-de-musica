# Copia este archivo como .env y rellénalo.

# 1) Crea una app en https://developer.spotify.com/dashboard
#    - Redirect URI:  http://127.0.0.1:8888/callback   (exactamente así)
#    - APIs: marca "Web API"
#    Copia aquí el Client ID (no hace falta el Client Secret: usamos PKCE).
SPOTIFY_CLIENT_ID=

# 2) OPCIONAL pero muy recomendado: clasificación con IA (Claude).
#    Sin esta clave la app usa reglas locales (géneros del artista + palabras clave),
#    que funcionan pero son bastante menos precisas para ánimo y ocasión.
#    Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Puerto local (si lo cambias, cambia también el Redirect URI en Spotify)
PORT=8888
